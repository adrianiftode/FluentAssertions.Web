<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The bundled contract assembly. Its public surface is ADDITIVE-ONLY from now on:
    every flavour packs its own copy of Assertions.Web.dll, packages version
    independently, and a consumer can end up with the copy from a newer or older
    package. Removing or changing an existing member would become an unversioned
    binary contract between packages. Its <Version> is bumped on every change so
    conflict resolution always picks the newest copy.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <Version>3.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HttpMessageFormatter\HttpMessageFormatter.csproj" />
  </ItemGroup>
</Project>
